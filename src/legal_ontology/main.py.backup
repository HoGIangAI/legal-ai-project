from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from typing import List, Dict, Optional
import neo4j
import os
import logging
from contextlib import asynccontextmanager

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Models
class LegalEntity(BaseModel):
    id: str
    name: str
    type: str
    properties: Dict[str, str]

class Relationship(BaseModel):
    source: str
    target: str
    type: str
    properties: Dict[str, str]

class OntologyQuery(BaseModel):
    entity_id: Optional[str] = None
    entity_name: Optional[str] = None
    relationship_type: Optional[str] = None
    depth: int = 2

class OntologyResponse(BaseModel):
    entities: List[LegalEntity]
    relationships: List[Relationship]

# Neo4j connection
def get_neo4j_driver():
    return neo4j.GraphDatabase.driver(
        os.getenv("NEO4J_URI", "bolt://localhost:7687"),
        auth=(
            os.getenv("NEO4J_USER", "neo4j"),
            os.getenv("NEO4J_PASSWORD", "legalai123")
        )
    )

# Initialize ontology schema
async def initialize_ontology():
    try:
        driver = get_neo4j_driver()
        with driver.session() as session:
            # Create constraints
            session.run("CREATE CONSTRAINT IF NOT EXISTS FOR (e:LegalEntity) REQUIRE e.id IS UNIQUE")
            session.run("CREATE CONSTRAINT IF NOT EXISTS FOR (e:LegalEntity) REQUIRE e.name IS UNIQUE")
            
            # Clear existing data for clean start
            session.run("MATCH (n) DETACH DELETE n")
            
            # Create sample legal ontology with proper relationships
            sample_data = [
                {
                    "id": "law_001", 
                    "name": "Bộ luật Lao động 2019", 
                    "type": "LAW", 
                    "description": "Bộ luật điều chỉnh quan hệ lao động"
                },
                {
                    "id": "article_001", 
                    "name": "Điều 1. Phạm vi điều chỉnh", 
                    "type": "ARTICLE", 
                    "description": "Phạm vi điều chỉnh của Bộ luật Lao động"
                },
                {
                    "id": "article_002", 
                    "name": "Điều 2. Giải thích từ ngữ", 
                    "type": "ARTICLE", 
                    "description": "Giải thích các thuật ngữ trong luật lao động"
                },
                {
                    "id": "concept_001", 
                    "name": "Hợp đồng lao động", 
                    "type": "CONCEPT", 
                    "description": "Thỏa thuận giữa người lao động và người sử dụng lao động"
                }
            ]
            
            # Create entities
            for entity in sample_data:
                session.run("""
                    MERGE (e:LegalEntity {id: $id})
                    SET e.name = $name, e.type = $type, e.description = $description
                """, 
                id=entity["id"],
                name=entity["name"], 
                type=entity["type"],
                description=entity["description"])
            
            # Create relationships
            relationships = [
                {"source": "article_001", "target": "law_001", "type": "BELONGS_TO"},
                {"source": "article_002", "target": "law_001", "type": "BELONGS_TO"},
                {"source": "concept_001", "target": "article_002", "type": "DEFINED_IN"},
            ]
            
            for rel in relationships:
                session.run("""
                    MATCH (source:LegalEntity {id: $source_id})
                    MATCH (target:LegalEntity {id: $target_id})
                    MERGE (source)-[r:RELATES_TO {type: $rel_type}]->(target)
                """, 
                source_id=rel["source"],
                target_id=rel["target"],
                rel_type=rel["type"])
                
        logger.info("Legal ontology initialized successfully")
    except Exception as e:
        logger.error(f"Failed to initialize ontology: {str(e)}")

# Lifespan handler
@asynccontextmanager
async def lifespan(app: FastAPI):
    await initialize_ontology()
    yield

app = FastAPI(title="Legal Ontology Service", version="1.0.0", lifespan=lifespan)

@app.get("/health")
async def health_check():
    return {"status": "healthy", "service": "legal_ontology"}

def build_cypher_query(depth: int):
    """Build dynamic Cypher query based on depth - FIXED VERSION"""
    if depth == 1:
        return """
            MATCH (start:LegalEntity {name: $entity_name})
            OPTIONAL MATCH (start)-[r:RELATES_TO]-(related:LegalEntity)
            RETURN start as main_entity, 
                   COLLECT(DISTINCT related) as related_nodes,
                   COLLECT(DISTINCT r) as related_rels
        """
    elif depth == 2:
        return """
            MATCH (start:LegalEntity {name: $entity_name})
            OPTIONAL MATCH (start)-[r1:RELATES_TO]-(related1:LegalEntity)
            OPTIONAL MATCH (related1)-[r2:RELATES_TO]-(related2:LegalEntity)
            RETURN start as main_entity,
                   COLLECT(DISTINCT related1) + COLLECT(DISTINCT related2) as related_nodes,
                   COLLECT(DISTINCT r1) + COLLECT(DISTINCT r2) as related_rels
        """
    else:  # depth >= 3
        return """
            MATCH (start:LegalEntity {name: $entity_name})
            OPTIONAL MATCH (start)-[r:RELATES_TO*1..3]-(related:LegalEntity)
            UNWIND r as single_rel
            UNWIND related as single_node
            RETURN start as main_entity,
                   COLLECT(DISTINCT single_node) as related_nodes,
                   COLLECT(DISTINCT single_rel) as related_rels
        """

@app.post("/api/v1/ontology/query", response_model=OntologyResponse)
async def query_ontology(query: OntologyQuery):
    try:
        driver = get_neo4j_driver()
        with driver.session() as session:
            
            if query.entity_name:
                # First check if entity exists
                check_result = session.run(
                    "MATCH (e:LegalEntity {name: $name}) RETURN e",
                    name=query.entity_name
                )
                
                if not check_result.single():
                    # Entity not found, return empty response
                    return OntologyResponse(entities=[], relationships=[])
                
                # Build appropriate query based on depth
                cypher_query = build_cypher_query(min(query.depth, 3))  # Limit depth to 3
                logger.info(f"Executing Cypher query for depth {query.depth}")
                
                # Execute query
                result = session.run(cypher_query, entity_name=query.entity_name)
                
                record = result.single()
                if not record:
                    return OntologyResponse(entities=[], relationships=[])
                
                # Collect all entities
                entities = []
                relationships = []
                
                # Add main entity
                main_entity = record["main_entity"]
                if main_entity:
                    entities.append(LegalEntity(
                        id=main_entity["id"],
                        name=main_entity["name"],
                        type=main_entity["type"],
                        properties={k: v for k, v in main_entity.items() 
                                  if k not in ["id", "name", "type"]}
                    ))
                
                # Add related entities (filter out None values)
                related_nodes = [node for node in (record["related_nodes"] or []) if node is not None]
                for node in related_nodes:
                    # Avoid duplicates
                    if not any(e.id == node["id"] for e in entities):
                        entities.append(LegalEntity(
                            id=node["id"],
                            name=node["name"],
                            type=node["type"],
                            properties={k: v for k, v in node.items() 
                                      if k not in ["id", "name", "type"]}
                        ))
                
                # Add relationships (filter out None values)
                related_rels = [rel for rel in (record["related_rels"] or []) if rel is not None]
                for rel in related_rels:
                    try:
                        relationships.append(Relationship(
                            source=rel.start_node["id"],
                            target=rel.end_node["id"],
                            type=rel.type,
                            properties=dict(rel)
                        ))
                    except Exception as rel_error:
                        logger.warning(f"Skipping relationship due to error: {rel_error}")
                        continue
                
                logger.info(f"Query successful: found {len(entities)} entities and {len(relationships)} relationships")
                return OntologyResponse(
                    entities=entities,
                    relationships=relationships
                )
                
            else:
                raise HTTPException(
                    status_code=400, 
                    detail="entity_name must be provided"
                )
            
    except Exception as e:
        logger.error(f"Ontology query failed: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Query failed: {str(e)}")

@app.post("/api/v1/ontology/expand")
async def expand_ontology(entity_data: LegalEntity, relationships: List[Relationship]):
    try:
        driver = get_neo4j_driver()
        with driver.session() as session:
            # Create/update entity
            session.run("""
                MERGE (e:LegalEntity {id: $id})
                SET e += $properties
            """, id=entity_data.id, properties={
                "name": entity_data.name,
                "type": entity_data.type,
                **entity_data.properties
            })
            
            # Create relationships
            for rel in relationships:
                session.run("""
                    MATCH (source:LegalEntity {id: $source_id})
                    MATCH (target:LegalEntity {id: $target_id})
                    MERGE (source)-[r:RELATES_TO {type: $rel_type}]->(target)
                    SET r += $properties
                """, 
                source_id=rel.source, 
                target_id=rel.target, 
                rel_type=rel.type, 
                properties=rel.properties)
            
        return {"status": "success", "message": "Ontology expanded successfully"}
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Expansion failed: {str(e)}")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8003, log_level="info")
